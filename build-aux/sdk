#!/bin/sh
# Run a command (usually cargo) inside the GNOME SDK with the Rust extension.
#   build-aux/sdk cargo test
#   build-aux/sdk cargo clippy --all-targets
# Uses a separate target dir so it doesn't fight with host or Builder builds.
set -e
cmd="$1"; shift
root="$(cd "$(dirname "$0")/.." && pwd)"
exec flatpak run --share=network --filesystem="$root" --filesystem=~/.cargo \
    --env=CARGO_TARGET_DIR="$root/target/sdk" \
    --env=PATH=/usr/lib/sdk/rust-stable/bin:/app/bin:/usr/bin \
    --cwd="$root" --command="$cmd" org.gnome.Sdk//51 "$@"
